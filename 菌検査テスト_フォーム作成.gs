function createQuizForm() {
  var form = FormApp.create('惣菜の菌検査 基礎と不適合対策 理解度テスト');
  form.setIsQuiz(true);
  form.setDescription('新人商品開発者向け教育資料の理解度テストです。全48問（満点51点）。氏名と所属を入力して、回答してください。');
  form.setShuffleQuestions(false);
  form.setAllowResponseEdits(false);
  form.setShowLinkToRespondAgain(false);
  form.setConfirmationMessage('回答ありがとうございました。結果は講師から共有します。');
  // form.setCollectEmail(true);
  // form.setLimitOneResponsePerUser(true);

  form.addTextItem().setTitle('氏名').setRequired(true);
  form.addTextItem().setTitle('所属（部署）').setRequired(true);

  var currentChapter = '';
  QUESTIONS.forEach(function (q, i) {
    if (q.ch !== currentChapter) {
      currentChapter = q.ch;
      form.addSectionHeaderItem().setTitle(currentChapter);
    }
    var title = 'Q' + (i + 1) + '. ' + q.q;
    var item;
    if (q.type === 'multi') {
      item = form.addCheckboxItem();
      item.setHelpText('当てはまるものをすべて選んでください。（資料 p.' + q.slide + '）');
    } else {
      item = form.addMultipleChoiceItem();
      item.setHelpText('（資料 p.' + q.slide + '）');
    }
    item.setTitle(title).setPoints(q.pt).setRequired(true);
    item.setChoices(q.options.map(function (text, k) {
      return item.createChoice(text, q.answer.indexOf(k) >= 0);
    }));
    item.setFeedbackForCorrect(FormApp.createFeedback().setText('正解です。' + q.exp).build());
    item.setFeedbackForIncorrect(FormApp.createFeedback().setText('解説：' + q.exp).build());
  });

  Logger.log('編集URL: ' + form.getEditUrl());
  Logger.log('回答用URL: ' + form.getPublishedUrl());
}
